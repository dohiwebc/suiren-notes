---
import CategoryBadge from "./CategoryBadge.astro";
import type { Work } from "../lib/microcms";
import { buildMicroCMSSrcSet, getOptimizedImageUrl } from "../lib/utils";
import { getWorkCategories } from "../lib/microcms";

interface Props {
  work: Work;
}

const { work } = Astro.props;
const imgUrl = getOptimizedImageUrl(work.thumbnail, work.title, {
  width: 640,
  quality: 72,
  fit: "crop",
  format: "webp",
});
const srcset = buildMicroCMSSrcSet(
  typeof work.thumbnail === "string" ? work.thumbnail : work.thumbnail?.url || imgUrl,
  [320, 480, 640],
  { quality: 72, fit: "crop", format: "webp" }
);
const demoUrl =
  work.url && /^https?:\/\//i.test(work.url.trim()) ? work.url.trim() : null;
---

<article class="card card--work">
  <div class="card__image-wrap">
    <img
      src={imgUrl}
      srcset={srcset || undefined}
      sizes="(max-width: 519px) 92vw, (max-width: 959px) 45vw, 320px"
      alt=""
      class="card__image"
      loading="lazy"
      decoding="async"
      width="400"
      height="225"
    />
  </div>
  <div class="card__body">
    <CategoryBadge categories={getWorkCategories(work)} />
    <h3 class="card__title">{work.title}</h3>
    <p class="card__description">{work.description || ""}</p>
    <div class="card__actions">
      <button type="button" class="btn btn--small btn--secondary" data-work-detail={work.id}>
        詳細を見る
      </button>
      {
        demoUrl && (
          <a
            href={demoUrl}
            class="btn btn--small btn--accent"
            target="_blank"
            rel="noopener noreferrer"
          >
            デモを見る
          </a>
        )
      }
    </div>
  </div>
</article>
