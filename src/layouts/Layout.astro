---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_CONFIG, assetUrl, getSiteUrl } from "../config";
import { getProfile } from "../lib/microcms";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  /** LCP画像の先読み（http(s) のときのみ） */
  preloadImage?: string;
  articlePublishedAt?: string;
  articleModifiedAt?: string;
  pageClass?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogType = "website",
  ogImage,
  preloadImage,
  articlePublishedAt,
  articleModifiedAt,
  pageClass = "",
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = getSiteUrl();
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl + "/").href;
const imageUrl = ogImage
  ? ogImage.startsWith("http")
    ? ogImage
    : `${siteUrl}${ogImage}`
  : `${siteUrl}${SITE_CONFIG.ogImage}`;

const profile = await getProfile();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    {
      SITE_CONFIG.googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={SITE_CONFIG.googleSiteVerification}
        />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    {
      ogType === "article" && articlePublishedAt && (
        <meta property="article:published_time" content={articlePublishedAt} />
      )
    }
    {
      ogType === "article" && articleModifiedAt && (
        <meta property="article:modified_time" content={articleModifiedAt} />
      )
    }
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_CONFIG.name} RSS`} href={`${siteUrl}/rss.xml`} />
    {
      preloadImage &&
        /^https?:\/\//i.test(preloadImage) && (
          <link
            rel="preload"
            as="image"
            href={preloadImage}
            type="image/webp"
            fetchpriority="high"
          />
        )
    }
    <link rel="stylesheet" href={assetUrl("/css/style.css")} />
    <script is:inline define:vars={{ privacyHref: "/privacy/" }}>
      window.SUIREN_FROM_ROOT = "/";
      window.SUIREN_BLOG_INDEX = "/blog/";
      window.SUIREN_PRIVACY_HREF = privacyHref;
    </script>
    <script is:inline src={assetUrl("/js/gtag-init.js")}></script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE_CONFIG.gaId}`}></script>
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body>
    <div class={`page ${pageClass}`.trim()}>
      <Header currentPath={Astro.url.pathname} />
      <main class="page__main">
        <slot />
      </main>
      <Footer profile={profile} year={year} />
    </div>
    <script is:inline src={assetUrl("/js/consent.js")}></script>
    <script is:inline src={assetUrl("/js/animations.js")}></script>
    <script is:inline>
      (function initHeader() {
        const header = document.getElementById("site-header") || document.querySelector(".header");
        const spacer = document.getElementById("header-spacer");
        if (!header) return;

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const mobileQuery = window.matchMedia("(max-width: 767px)");
        const SCROLL_ON = 28;
        const SCROLL_OFF = 6;
        let scrolled = false;

        function syncSpacer() {
          if (!spacer) return;
          if (!mobileQuery.matches) {
            spacer.style.height = "";
            return;
          }
          spacer.style.height = `${Math.ceil(header.getBoundingClientRect().height)}px`;
        }

        function updateScrollState() {
          if (mobileQuery.matches) {
            if (scrolled) {
              scrolled = false;
              header.classList.remove("header--scrolled");
            }
            return;
          }
          const y = window.scrollY || 0;
          if (!scrolled && y > SCROLL_ON) {
            scrolled = true;
            header.classList.add("header--scrolled");
          } else if (scrolled && y < SCROLL_OFF) {
            scrolled = false;
            header.classList.remove("header--scrolled");
          }
        }

        function showHeader() {
          header.classList.add("header--ready");
        }

        /* スマホは入場アニメなし・スクロール監視なし */
        if (mobileQuery.matches || reduceMotion) {
          showHeader();
        } else {
          requestAnimationFrame(showHeader);
        }

        syncSpacer();
        updateScrollState();

        window.addEventListener(
          "scroll",
          function onScroll() {
            if (mobileQuery.matches) return;
            updateScrollState();
          },
          { passive: true }
        );

        window.addEventListener("resize", syncSpacer, { passive: true });
        if (window.visualViewport) {
          window.visualViewport.addEventListener("resize", syncSpacer, { passive: true });
        }

        function onBreakpointChange() {
          header.classList.remove("header--scrolled");
          scrolled = false;
          showHeader();
          syncSpacer();
          updateScrollState();
        }

        if (typeof mobileQuery.addEventListener === "function") {
          mobileQuery.addEventListener("change", onBreakpointChange);
        } else if (typeof mobileQuery.addListener === "function") {
          mobileQuery.addListener(onBreakpointChange);
        }
      })();
    </script>
  </body>
</html>
